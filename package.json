{
  "name": "teammate-ai",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "agents",
    "server",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w frontend\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w frontend",
    "agents:dry": "npm run dry -w agents --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "agents:eval": "npm run eval -w agents --"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
