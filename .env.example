# 复制为 .env 后填写。不要提交 .env。
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# scripted = 播放写死的事件（不需要任何 key，前端开发用）
# replay   = 播放 fixtures 里的对话，交给真实 agent 判断（需要 ANTHROPIC_API_KEY）
# live     = 真实麦克风（需要 DEEPGRAM_API_KEY，待实现）
MODE=scripted
REPLAY_SPEED=1
PORT=8787

# 模型。主 agent 每句话后都要判断一次：实测 Sonnet 5.5 比 Haiku 5.5 更准也更稳（见 npm run agents:eval），贵约 20 倍。
# 想省钱可换成 claude-haiku-5-5。角色 agent 只在被叫到时运行，用强的。
ORCHESTRATOR_MODEL=claude-sonnet-5-5
ROLE_MODEL=claude-opus-5-5

# 声纹相似度达到多少算同一个人。服务端日志会打印每次比对的分数，认错人时调高，认不出时调低。
# VOICE_THRESHOLD=0.38
