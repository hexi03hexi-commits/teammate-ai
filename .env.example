# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Optional. Gives each teammate its own voice; without it the browser's built-in voice is used.
ELEVENLABS_API_KEY=

# scripted = plays a fixed conversation and fixed cards (no keys needed)
# replay   = plays the conversation in fixtures/ to the real models (needs ANTHROPIC_API_KEY)
# live     = the host device's microphone (needs ANTHROPIC_API_KEY and DEEPGRAM_API_KEY)
MODE=scripted
REPLAY_SPEED=1
PORT=8787

# Models. Atlas decides after every pause, so it has to be fast and steady: Sonnet 5.5 was more
# consistent than Haiku 5.5 on the evals (npm run agents:eval). claude-haiku-5-5 is the cheaper option.
# The specialists run only when called, so they get the strongest model.
ORCHESTRATOR_MODEL=claude-sonnet-5-5
ROLE_MODEL=claude-opus-5-5

# How similar two voices must be to count as the same person. The server log prints the score of
# every comparison: raise this if people are mistaken for each other, lower it if they go unrecognised.
# VOICE_THRESHOLD=0.38
